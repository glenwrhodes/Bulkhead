# Turns ctest's JUnit file into a Markdown table: each test, passed / skipped / failed,
# its time, and for a failure the first line that says why. Printed to the log, and
# appended to OUT if given (CI passes the run page's summary file, $GITHUB_STEP_SUMMARY).
#
#   ctest ... --output-junit junit.xml
#   cmake -DJUNIT=<build>/junit.xml [-DOUT=<file>] -P cmake/TestSummary.cmake

file(TO_CMAKE_PATH "${JUNIT}" JUNIT)
if(OUT)
  file(TO_CMAKE_PATH "${OUT}" OUT)
endif()
if(NOT JUNIT OR NOT EXISTS "${JUNIT}")
  message(FATAL_ERROR "TestSummary: no JUnit file at '${JUNIT}'")
endif()
file(READ "${JUNIT}" xml)

# One list item per <testcase>. Semicolons and square brackets mean something to CMake
# lists, so park them as tokens first.
string(REPLACE ";" "@SEMI@" xml "${xml}")
string(REPLACE "[" "@LB@" xml "${xml}")
string(REPLACE "]" "@RB@" xml "${xml}")
string(REPLACE "<testcase " ";" cases "${xml}")
list(POP_FRONT cases)  # the <testsuite> header

function(unescape var text)
  string(REPLACE "@SEMI@" ";" text "${text}")
  string(REPLACE "@LB@" "[" text "${text}")
  string(REPLACE "@RB@" "]" text "${text}")
  string(REPLACE "&quot;" "\"" text "${text}")
  string(REPLACE "&apos;" "'" text "${text}")
  string(REPLACE "&lt;" "<" text "${text}")
  string(REPLACE "&gt;" ">" text "${text}")
  string(REPLACE "&amp;" "&" text "${text}")
  string(REPLACE "|" "\\|" text "${text}")
  set(${var} "${text}" PARENT_SCOPE)
endfunction()

set(rows "")
set(passed 0)
set(skipped 0)
set(failed 0)
foreach(c IN LISTS cases)
  string(REGEX MATCH "name=\"([^\"]*)\"" _ "${c}")
  set(name "${CMAKE_MATCH_1}")
  string(REGEX MATCH "time=\"([^\"]*)\"" _ "${c}")
  set(time "${CMAKE_MATCH_1}")
  string(REGEX MATCH "status=\"([^\"]*)\"" _ "${c}")
  set(status "${CMAKE_MATCH_1}")
  set(out "")
  if(c MATCHES "<system-out>([^<]*)")
    set(out "${CMAKE_MATCH_1}")
  endif()
  string(REPLACE "\r" "" out "${out}")
  string(REPLACE "\n" ";" lines "${out}")
  if(time MATCHES "^([0-9]+)(\\.([0-9]))?")
    set(secs "${CMAKE_MATCH_1}.${CMAKE_MATCH_3}")
    if(NOT CMAKE_MATCH_3)
      set(secs "${CMAKE_MATCH_1}.0")
    endif()
  else()
    set(secs "?")
  endif()
  set(note "")
  if(status STREQUAL "run")
    set(result "passed")
    math(EXPR passed "${passed} + 1")
  elseif(status STREQUAL "notrun")
    set(result "skipped")
    math(EXPR skipped "${skipped} + 1")
  else()
    set(result "**FAILED**")
    math(EXPR failed "${failed} + 1")
    foreach(l IN LISTS lines)
      if(l MATCHES "FAIL|[Ff]ailed|[Ee]rror")
        set(note "${l}")
        break()
      endif()
    endforeach()
  endif()
  string(STRIP "${note}" note)
  unescape(note "${note}")
  string(APPEND rows "| `${name}` | ${result} | ${secs} s | ${note} |\n")
endforeach()

set(md "## Tests: ${passed} passed, ${skipped} skipped, ${failed} failed\n\n")
string(APPEND md "| Test | Result | Time | Why |\n| --- | --- | --- | --- |\n${rows}")
string(APPEND md "\nThe ray-traced capture tests (labels smoke, film, bench, package) need a ray-tracing GPU and run on the development PC.\n")
message("${md}")
if(OUT)
  file(APPEND "${OUT}" "${md}\n")
endif()
